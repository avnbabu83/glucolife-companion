{
  "name": "MedicationLog",
  "type": "object",
  "properties": {
    "medication_id": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "scheduled_time": {
      "type": "string"
    },
    "taken_time": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "taken",
        "skipped",
        "late"
      ]
    },
    "glucose_at_time": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "medication_id",
    "date",
    "status"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}